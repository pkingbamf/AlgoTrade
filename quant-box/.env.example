APP_NAME=quant-box
ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg2://quant:quant@db:5432/quantbox
LOCAL_DATABASE_URL=sqlite:///./quant_box.db
DATA_DIR=./data
PROMOTION_MIN_TRADES=30
PROMOTION_MIN_OOS_SHARPE=0.8
PROMOTION_MAX_DRAWDOWN=0.2
RISK_MAX_POSITION_PCT=0.10
RISK_MAX_FAMILY_ALLOCATION_PCT=0.25
RISK_MAX_DAILY_LOSS_PCT=0.02
RISK_MAX_PORTFOLIO_DD_PCT=0.10
VOL_REDUCTION_THRESHOLD=0.35
